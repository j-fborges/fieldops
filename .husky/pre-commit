#!/usr/bin/env sh

staged=$(git diff --cached --name-only)

if [ -n "$staged" ]; then
  conflicts=$(echo "$staged" | xargs grep -l "^<<<<<<< " 2>/dev/null || true)
  if [ -n "$conflicts" ]; then
    echo "Unresolved merge conflicts in:"
    echo "$conflicts"
    exit 1
  fi
fi

npx lint-staged
npm run typecheck
npm run test
