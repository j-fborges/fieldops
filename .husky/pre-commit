#!/usr/bin/env sh

# Check for unresolved merge conflicts
files=$(git diff --cached --name-only)
if [ -n "$files" ]; then
  conflicts=$(echo "$files" | xargs grep -l "^<<<<<<< " 2>/dev/null)
  if [ -n "$conflicts" ]; then
    echo "Unresolved merge conflicts in:"
    echo "$conflicts"
    exit 1
  fi
fi

npx lint-staged
npm run typecheck
npm run test
