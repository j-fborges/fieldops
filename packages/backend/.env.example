# =============================================================================
# FieldOps Backend — Environment Variables
# =============================================================================
# Copy this file to .env and adjust for your local environment.
#   cp packages/backend/.env.example packages/backend/.env
# =============================================================================

# === App ===
APP_ENV=development
APP_DEBUG=true
APP_SECRET=change-me
APP_HOST=0.0.0.0
APP_PORT=8000

# === PostgreSQL ===
DATABASE_URL=postgresql+asyncpg://fieldops:fieldops@localhost:5432/fieldops

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === RabbitMQ (Celery) ===
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === MinIO / S3 ===
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=fieldops
MINIO_SECRET_KEY=fieldops-secret
MINIO_BUCKET=fieldops-media
MINIO_REGION=us-east-1

# === JWT ===
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
